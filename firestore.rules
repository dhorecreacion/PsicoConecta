rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pacientes/{dni} {
      // Este documento en sí ya no lo escribe ninguna vista (ver
      // pacientes/{dni}/citas más abajo); se deja de solo lectura por los
      // docs viejos que fetchTodasLasCitas() todavía necesita leer para
      // migrarlos una sola vez (fb-psico.js).
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;

      match /sesiones/{sesionId} {
        allow read, write: if true;
      }

      match /historial_citas/{historialId} {
        // La reserva pública (index.html, sin login) crea el evento
        // "reservada"; la app en vivo nunca actualiza un documento existente
        // aquí (siempre agrega uno nuevo). "update" solo lo usa el importador
        // de pacientes.html/js/importador.js: sus IDs son determinísticos
        // (imp-cita-dni-fecha-n), así que reimportar el mismo Excel
        // sobreescribe en vez de duplicar — igual que ya pasa con "sesiones".
        // "if true" en el read, igual que sesiones: este proyecto (fb-psico)
        // no tiene Auth propio, así que no hay un request.auth real aquí.
        allow create, update: if request.resource.data.estado is string;
        allow read: if true;
        allow delete: if false;
      }

      // Cada cita es su propio documento (en vez de un único pacientes/{dni}
      // que se sobreescribía con cada reserva nueva) — así un mismo DNI
      // puede tener varias citas vigentes a la vez (ej. una para el
      // colaborador y otra para su familiar, el mismo día). "create" lo usa
      // tanto la reserva pública (index.html) como "Nueva Cita"/Reprogramar/
      // No Asistió en agenda.html; "update" lo usa Reprogramar/No Asistió/
      // atencion.js sobre una cita que ya existe.
      match /citas/{citaId} {
        allow read: if true;
        allow create: if request.resource.data.dni is string
                      && request.resource.data.dni.size() > 0
                      && request.resource.data.dni.size() < 10;
        allow update: if request.resource.data.dni == resource.data.dni;
        allow delete: if false;
      }
    }

    // Necesario aparte para que collectionGroup(dbPsico, "sesiones")
    // pueda consultar todas las subcolecciones "sesiones" a la vez.
    match /{path=**}/sesiones/{sesionId} {
      allow read, write: if true;
    }

    // Igual, para collectionGroup(dbPsico, "historial_citas") en indicadores.js.
    match /{path=**}/historial_citas/{historialId} {
      allow read: if true;
    }

    // Igual, para collectionGroup(dbPsico, "citas") en index.js/agenda.js/
    // pacientes.js/fb-psico.js (fetchTodasLasCitas).
    match /{path=**}/citas/{citaId} {
      allow read: if true;
      allow create: if request.resource.data.dni is string
                    && request.resource.data.dni.size() > 0
                    && request.resource.data.dni.size() < 10;
      allow update: if request.resource.data.dni == resource.data.dni;
      allow delete: if false;
    }

    match /disponibilidad/{dia} {
      allow read, write: if true;
    }

    // Disponibilidad por fecha exacta (reemplaza la plantilla semanal para
    // el mes en curso y los 2 siguientes): un doc por fecha con sus propios
    // bloques — una fecha sin doc, o sin bloques, no es reservable. Así se
    // cubre tanto "esta semana sí, la siguiente no" (vacaciones) como
    // "este lunes distinto del otro lunes", sin una plantilla que se repita.
    match /disponibilidad_fechas/{fechaId} {
      allow read, write: if true;
    }

    // Casos cerrados/reabiertos a mano (pacientes.html / atencion.html), para
    // "Casos Activos" en indicadores.html. Mismo criterio "if true" que el
    // resto: este proyecto (fb-psico) no tiene Auth propio.
    match /casos/{dni} {
      allow read, write: if true;
    }

    // Ajustes de configuracion.html: umbral de seguimiento (doc "general")
    // y catálogos de derivación/acciones (doc "catalogos"). Los lee
    // atencion.html (sin login todavía en el momento de reservar), por eso
    // "if true" igual que el resto de este proyecto.
    match /configuracion/{docId} {
      allow read, write: if true;
    }

    // Contratas: registros importados desde Excel (contratas.html /
    // js/importador-contratas.js) — colección plana, sin reserva pública ni
    // agenda, mismo criterio "if true" que el resto de fb-psico.
    match /contratas_registros/{registroId} {
      allow read, write: if true;
    }

    // Casos de Contratas cerrados/reabiertos a mano — espeja /casos.
    match /contratas_casos/{dni} {
      allow read, write: if true;
    }
  }
}
